# Environment variables for EnduranceNet
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Required for production ────────────────────────────────────────────────────
# Your public domain name (e.g. www.endurance.net)
DOMAIN=localhost

# Secret key for the Scala Play application (min 32 chars, generate with:
#   openssl rand -base64 48
APPLICATION_SECRET=changeme_replace_in_production_min32chars

# Email address for Let's Encrypt certificate expiry notifications
EMAIL=admin@example.com

# ── Optional ───────────────────────────────────────────────────────────────────
# Set to 1 to use Let's Encrypt staging CA (useful for testing, avoids rate limits)
# STAGING=0
