# Routes
GET     /                           controllers.HomeController.index()
GET     /api/health                 controllers.ApiController.health()
GET     /api/events                 controllers.EventController.list()
GET     /api/events/:id             controllers.EventController.get(id: Long)
GET     /api/news                   controllers.NewsController.list()
GET     /api/news/:id               controllers.NewsController.get(id: Long)
GET     /api/streams                controllers.StreamController.sources()
GET     /api/streams/:slug          controllers.StreamController.source(slug: String)
GET     /api/streams/:slug/entries  controllers.StreamController.entriesForSource(slug: String)
GET     /api/stream-entries/search  controllers.StreamController.searchEntries()
GET     /api/stream-entries         controllers.StreamController.entries()
GET     /api/homepage-assets        controllers.LegacyController.homepageAssets()
GET     /api/legacy-redirects       controllers.LegacyController.redirects()
GET     /api/legacy-redirects/resolve controllers.LegacyController.resolveRedirect()
GET     /api/athletes               controllers.AthleteController.list()
GET     /api/athletes/:id           controllers.AthleteController.get(id: Long)
GET     /api/results                controllers.ResultController.list()
GET     /api/results/:eventId       controllers.ResultController.byEvent(eventId: Long)
OPTIONS /api/*path                  controllers.ApiController.preflight(path: String)
